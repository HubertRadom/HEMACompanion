# Integration test environment — copy to .env.test.local and populate from `supabase status`.
# .env.test.local is gitignored. Never commit credentials.
#
# Local Supabase CLI defaults (run `supabase start` first, then `supabase status`):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<service_role_key from supabase status>
SUPABASE_ANON_KEY=<anon_key from supabase status>
