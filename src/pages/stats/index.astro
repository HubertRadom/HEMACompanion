---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import type { Fight } from "@/lib/types";
import { computeStats } from "@/lib/stats";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;

let fights: Fight[] = [];
let gearSets: { id: string; name: string }[] = [];
let gearItems: { id: string; name: string }[] = [];
let compositions: { gear_set_id: string; gear_item_id: string }[] = [];
let error: string | null = null;

if (supabase && user) {
  const [fightsResult, setsResult, itemsResult] = await Promise.all([
    supabase.from("fights").select("*").eq("user_id", user.id),
    supabase.from("gear_sets").select("id, name").eq("user_id", user.id),
    supabase.from("gear_items").select("id, name").eq("user_id", user.id),
  ]);

  error = fightsResult.error?.message ?? setsResult.error?.message ?? itemsResult.error?.message ?? null;

  fights = (fightsResult.data ?? []) as Fight[];
  gearSets = setsResult.data ?? [];
  gearItems = itemsResult.data ?? [];

  const gearSetIds = gearSets.map((s) => s.id);
  // scoped via gearSetIds (user-filtered) + RLS on gear_sets.user_id
  if (gearSetIds.length > 0) {
    const compositionsResult = await supabase
      .from("gear_set_compositions")
      .select("gear_set_id, gear_item_id")
      .in("gear_set_id", gearSetIds);
    compositions = compositionsResult.data ?? [];
    error = error ?? compositionsResult.error?.message ?? null;
  }
}

// Aggregations

const {
  totalFights,
  fightCountByCategory,
  globalWinRate,
  winRateByCategory,
  topOpponents,
  gearItemCounts,
  gearSetUsage,
} = computeStats({ fights, gearSets, gearItems, compositions });
---

<AppLayout title="Statistics">
  <div class="mx-auto max-w-3xl px-6 py-10">
    <div class="mb-6">
      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        My Statistics
      </h1>
    </div>

    {
      error && (
        <p class="mb-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">{error}</p>
      )
    }

    {
      totalFights === 0 ? (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-12 text-center">
          <p class="mb-4 text-blue-100/60">No fights logged yet.</p>
          <a
            href="/fights/add"
            class="inline-block rounded-lg border border-white/20 bg-white/10 px-5 py-2 text-sm text-white transition-colors hover:bg-white/20"
          >
            Log your first fight
          </a>
        </div>
      ) : (
        <div class="space-y-4">
          <div class="rounded-xl border border-white/10 bg-white/5 px-5 py-4">
            <h2 class="mb-3 text-sm font-semibold tracking-wide text-blue-100/50 uppercase">Fight Summary</h2>
            <div class="mb-3 flex items-baseline gap-2">
              <span class="text-3xl font-bold text-white">{totalFights}</span>
              <span class="text-sm text-blue-100/60">total fights</span>
            </div>
            {fightCountByCategory.length > 0 && (
              <ul class="space-y-1 border-t border-white/5 pt-3">
                {fightCountByCategory.map((c) => (
                  <li class="flex items-center justify-between text-sm">
                    <span class="text-blue-100/70 capitalize">{c.category}</span>
                    <span class="text-white">{c.count}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div class="rounded-xl border border-white/10 bg-white/5 px-5 py-4">
            <h2 class="mb-3 text-sm font-semibold tracking-wide text-blue-100/50 uppercase">Win Rate</h2>
            <div class="mb-3 flex items-baseline gap-2">
              <span class="text-3xl font-bold text-white">{globalWinRate}</span>
              <span class="text-sm text-blue-100/60">overall</span>
            </div>
            {winRateByCategory.length > 0 && (
              <ul class="space-y-1 border-t border-white/5 pt-3">
                {winRateByCategory.map((c) => (
                  <li class="flex items-center justify-between text-sm">
                    <span class="text-blue-100/70 capitalize">{c.category}</span>
                    <span class="text-white">{c.rate}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div class="rounded-xl border border-white/10 bg-white/5 px-5 py-4">
            <h2 class="mb-3 text-sm font-semibold tracking-wide text-blue-100/50 uppercase">Top Opponents</h2>
            <ul class="space-y-1">
              {topOpponents.map((o, i) => (
                <li class="flex items-center justify-between text-sm">
                  <div class="flex items-center gap-2">
                    <span class="w-4 text-xs text-blue-100/30">{i + 1}.</span>
                    <span class="text-white">{o.name}</span>
                  </div>
                  <span class="text-blue-100/70">
                    {o.count} {o.count === 1 ? "fight" : "fights"}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          {gearItemCounts.length > 0 && (
            <div class="rounded-xl border border-white/10 bg-white/5 px-5 py-4">
              <h2 class="mb-3 text-sm font-semibold tracking-wide text-blue-100/50 uppercase">Gear Items</h2>
              <ul class="space-y-1">
                {gearItemCounts.map((item) => (
                  <li class="flex items-center justify-between text-sm">
                    <span class="text-white">{item.name}</span>
                    <span class="text-blue-100/70">
                      {item.count} {item.count === 1 ? "fight" : "fights"}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {gearSetUsage.length > 0 && (
            <div class="rounded-xl border border-white/10 bg-white/5 px-5 py-4">
              <h2 class="mb-3 text-sm font-semibold tracking-wide text-blue-100/50 uppercase">Gear Sets</h2>
              <ul class="space-y-1">
                {gearSetUsage.map((set) => (
                  <li class="flex items-center justify-between text-sm">
                    <span class="text-white">{set.name}</span>
                    <span class="text-blue-100/70">
                      {set.count} {set.count === 1 ? "fight" : "fights"}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )
    }
  </div>
</AppLayout>
