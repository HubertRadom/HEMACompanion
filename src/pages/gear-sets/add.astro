---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import GearSetForm from "@/components/gear/GearSetForm";
import type { GearItem } from "@/lib/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;
const result =
  supabase && user
    ? await supabase.from("gear_items").select("id, name, category").eq("user_id", user.id).order("name")
    : null;

const gearItems = (result?.data ?? []) as GearItem[];
const serverError = result?.error?.message ?? Astro.url.searchParams.get("error");
---

<AppLayout title="Create Gear Set">
  <div class="mx-auto max-w-xl px-6 py-10">
    <div class="mb-6">
      <a href="/gear-sets" class="text-sm text-blue-100/60 hover:text-white">← Gear Sets</a>
      <h1 class="mt-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Create Gear Set
      </h1>
    </div>

    {
      gearItems.length === 0 ? (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-10 text-center">
          <p class="mb-4 text-blue-100/60">You have no gear items yet. Add one before creating a set.</p>
          <a
            href="/gear/add"
            class="inline-block rounded-lg border border-white/20 bg-white/10 px-5 py-2 text-sm text-white transition-colors hover:bg-white/20"
          >
            Add a gear item
          </a>
        </div>
      ) : (
        <GearSetForm action="/api/gear-sets" availableItems={gearItems} serverError={serverError} client:load />
      )
    }
  </div>
</AppLayout>
