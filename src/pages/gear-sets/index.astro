---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import type { GearItem, GearSet } from "@/lib/types";

type GearSetRow = GearSet & {
  gear_set_compositions: { gear_items: Pick<GearItem, "id" | "name" | "category"> | null }[];
};

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;
const result =
  supabase && user
    ? await supabase
        .from("gear_sets")
        .select("*, gear_set_compositions(gear_items(id, name, category))")
        .eq("user_id", user.id)
        .order("created_at", { ascending: false })
    : null;

const gearSets = (result?.data ?? []) as GearSetRow[];
const error = result?.error?.message ?? Astro.url.searchParams.get("error");
---

<AppLayout title="My Gear Sets">
  <div class="mx-auto max-w-3xl px-6 py-10">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        My Gear Sets
      </h1>
      <a
        href="/gear-sets/add"
        class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
      >
        + Create gear set
      </a>
    </div>

    {
      error && (
        <p class="mb-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">{error}</p>
      )
    }

    {
      gearSets.length === 0 ? (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-12 text-center">
          <p class="mb-4 text-blue-100/60">No gear sets yet.</p>
          <a
            href="/gear-sets/add"
            class="inline-block rounded-lg border border-white/20 bg-white/10 px-5 py-2 text-sm text-white transition-colors hover:bg-white/20"
          >
            Create your first gear set
          </a>
        </div>
      ) : (
        <ul class="space-y-3">
          {gearSets.map((set) => {
            const itemNames = set.gear_set_compositions
              .map((c) => c.gear_items?.name)
              .filter(Boolean)
              .join(", ");
            return (
              <li class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-5 py-4">
                <div>
                  <span class="font-semibold text-white">{set.name}</span>
                  <p class="mt-0.5 text-sm text-blue-100/50">{itemNames || "No items"}</p>
                </div>
                <div class="flex items-center gap-2">
                  <a
                    href={`/gear-sets/${set.id}/edit`}
                    class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-sm text-white transition-colors hover:bg-white/20"
                  >
                    Edit
                  </a>
                  <form method="POST" action={`/api/gear-sets/${set.id}/delete`}>
                    <button
                      type="submit"
                      onclick="return confirm('Delete this gear set?')"
                      class="rounded-lg border border-red-500/30 bg-red-900/20 px-3 py-1.5 text-sm text-red-300 transition-colors hover:bg-red-900/40"
                    >
                      Delete
                    </button>
                  </form>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</AppLayout>
