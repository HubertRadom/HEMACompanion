---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import GearSetForm from "@/components/gear/GearSetForm";
import type { GearItem, GearSet } from "@/lib/types";

type GearSetWithCompositions = GearSet & {
  gear_set_compositions: { gear_item_id: string }[];
};

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;

const [setResult, itemsResult] =
  supabase && user
    ? await Promise.all([
        supabase
          .from("gear_sets")
          .select("*, gear_set_compositions(gear_item_id)")
          .eq("id", id)
          .eq("user_id", user.id)
          .maybeSingle(),
        supabase.from("gear_items").select("*").eq("user_id", user.id).order("name"),
      ])
    : [
        { data: null, error: null },
        { data: null, error: null },
      ];

const gearSet = setResult.data as GearSetWithCompositions | null;
const gearItems = (itemsResult.data ?? []) as GearItem[];
const selectedItemIds = gearSet?.gear_set_compositions.map((c) => c.gear_item_id) ?? [];
const error = setResult.error?.message ?? itemsResult.error?.message ?? Astro.url.searchParams.get("error");
---

<AppLayout title="Edit Gear Set">
  <div class="mx-auto max-w-xl px-6 py-10">
    <div class="mb-6">
      <a href="/gear-sets" class="text-sm text-blue-100/60 hover:text-white">← Gear Sets</a>
      <h1 class="mt-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Edit Gear Set
      </h1>
    </div>

    {
      !gearSet ? (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-10 text-center">
          <p class="mb-4 text-blue-100/60">Gear set not found.</p>
          <a
            href="/gear-sets"
            class="inline-block rounded-lg border border-white/20 bg-white/10 px-5 py-2 text-sm text-white transition-colors hover:bg-white/20"
          >
            Back to Gear Sets
          </a>
        </div>
      ) : (
        <GearSetForm
          action={`/api/gear-sets/${id}`}
          availableItems={gearItems}
          initialValues={{ name: gearSet.name }}
          selectedItemIds={selectedItemIds}
          serverError={error}
          client:load
        />
      )
    }
  </div>
</AppLayout>
