---
import AppLayout from "@/layouts/AppLayout.astro";
import GearItemForm from "@/components/gear/GearItemForm";
import { createClient } from "@/lib/supabase";
import type { GearItem } from "@/lib/types";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;
const queryResult =
  supabase && user
    ? await supabase.from("gear_items").select("*").eq("id", id).eq("user_id", user.id).maybeSingle()
    : { data: null, error: null };
const item = queryResult.data as GearItem | null;
const error = queryResult.error?.message ?? Astro.url.searchParams.get("error");
---

<AppLayout title="Edit Gear Item">
  <div class="mx-auto max-w-lg px-6 py-10">
    {
      item ? (
        <>
          <div class="mb-6 flex items-center gap-3">
            <a href="/gear" class="text-blue-100/50 transition-colors hover:text-blue-100/80">
              ← Gear
            </a>
            <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
              Edit Gear Item
            </h1>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
            <GearItemForm action={`/api/gear/${item.id}`} initialValues={item} serverError={error} client:load />
          </div>
        </>
      ) : (
        <div class="rounded-2xl border border-white/10 bg-white/5 p-12 text-center">
          <p class="mb-4 text-blue-100/60">Gear item not found.</p>
          <a
            href="/gear"
            class="inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
          >
            ← Back to gear
          </a>
        </div>
      )
    }
  </div>
</AppLayout>
