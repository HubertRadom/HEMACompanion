---
import AppLayout from "@/layouts/AppLayout.astro";
import GearItemForm from "@/components/gear/GearItemForm";

const error = Astro.url.searchParams.get("error");
---

<AppLayout title="Add Gear Item">
  <div class="mx-auto max-w-lg px-6 py-10">
    <div class="mb-6 flex items-center gap-3">
      <a href="/gear" class="text-blue-100/50 transition-colors hover:text-blue-100/80"> ← Gear </a>
      <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Add Gear Item
      </h1>
    </div>

    <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
      <GearItemForm action="/api/gear" serverError={error} client:load />
    </div>
  </div>
</AppLayout>
