---
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import FightForm from "@/components/fights/FightForm";
import type { GearSet } from "@/lib/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;
const result =
  supabase && user ? await supabase.from("gear_sets").select("id, name").eq("user_id", user.id).order("name") : null;

const gearSets = (result?.data ?? []) as GearSet[];
const serverError = result?.error?.message ?? Astro.url.searchParams.get("error");
---

<AppLayout title="Log Fight">
  <div class="mx-auto max-w-xl px-6 py-10">
    <div class="mb-6">
      <a href="/fights" class="text-sm text-blue-100/60 hover:text-white">← Fights</a>
      <h1 class="mt-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Log Fight
      </h1>
    </div>

    <FightForm action="/api/fights" gearSets={gearSets} serverError={serverError} client:load />
  </div>
</AppLayout>
