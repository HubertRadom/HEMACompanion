---
const pathname = Astro.url.pathname;
const isGear = pathname.startsWith("/gear");
---

<nav class="sticky top-0 z-10 border-b border-white/10 bg-black/30 backdrop-blur-xl">
  <div class="mx-auto flex max-w-5xl items-center gap-6 px-6 py-3">
    <span class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-sm font-bold text-transparent">
      HEMA Companion
    </span>

    <div class="flex flex-1 items-center gap-1">
      <a
        href="/gear"
        class:list={[
          "rounded-lg px-3 py-1.5 text-sm transition-colors",
          isGear ? "bg-white/15 text-white" : "text-blue-100/70 hover:bg-white/10 hover:text-white",
        ]}
      >
        Gear
      </a>
      <span class="cursor-default rounded-lg px-3 py-1.5 text-sm text-white/25">Gear Sets</span>
      <span class="cursor-default rounded-lg px-3 py-1.5 text-sm text-white/25">Fights</span>
      <span class="cursor-default rounded-lg px-3 py-1.5 text-sm text-white/25">Stats</span>
    </div>

    <form method="POST" action="/api/auth/signout">
      <button
        type="submit"
        class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-sm text-white transition-colors hover:bg-white/20"
      >
        Sign out
      </button>
    </form>
  </div>
</nav>
