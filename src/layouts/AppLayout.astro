---
import Layout from "@/layouts/Layout.astro";
import AppNav from "@/components/AppNav.astro";

interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<Layout title={title}>
  <div class="bg-cosmic flex min-h-screen flex-col">
    <AppNav />
    <main class="flex-1">
      <slot />
    </main>
  </div>
</Layout>
