{
  "name": "code-review-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scripted AI code-review agent built on the Claude Agent SDK. First version (single-shot diff review); to be wired into CI/CD in a later lesson.",
  "scripts": {
    "review": "tsx src/review.ts",
    "review:sample": "tsx src/review.ts fixtures/sample.diff",
    "gate": "node src/review-gate.mjs",
    "gate:sample": "node src/review-gate.mjs fixtures/sample.diff",
    "gate:clean": "node src/review-gate.mjs fixtures/clean.diff",
    "eval": "promptfoo eval -c promptfoo/promptfooconfig.yaml",
    "eval:view": "promptfoo view -y"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0"
  },
  "devDependencies": {
    "promptfoo": "^0.118.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "better-sqlite3": "^12.2.0"
  }
}
